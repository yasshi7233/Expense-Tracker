# Configuration & Environment Variables Example
# Copy this file to .env and configure values before starting the application

FLASK_CONFIG=development
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# PostgreSQL connection string for Production (e.g. Render / Neon / AWS RDS)
# Format: postgresql://<username>:<password>@<hostname>:<port>/<database_name>
DATABASE_URL=sqlite:///expense.db

# Production cookie security
SESSION_COOKIE_SECURE=False
PORT=5000
